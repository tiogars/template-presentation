{
  "name": "@tiogars/template-presentation",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm run build:html && pnpm run build:pdf && pnpm run build:pptx",
    "build:html": "marp src/slides.md --html --template bespoke --bespoke.progress --output dist/index.html",
    "build:pdf": "marp src/slides.md --html --pdf --pdf-outlines --output dist/template-presentation.pdf",
    "build:pptx": "marp src/slides.md --html --pptx --output dist/template-presentation.pptx",
    "dev": "cross-env PORT=8083 marp --server .",
    "format": "prettier --write src/slides.md"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^3.4.0",
    "cross-env": "^7.0.3",
    "prettier": "^3.3.3"
  }
}